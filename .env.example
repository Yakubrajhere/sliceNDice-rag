# Ollama server
OLLAMA_HOST=http://localhost:11434

# Models (pull first: ollama pull nomic-embed-text)
LLM_MODEL=qwen2.5:7b-instruct
EMBEDDING_MODEL=nomic-embed-text

# Paths
DATA_DIR=data
VECTORSTORE_DIR=vectorstore
COLLECTION_NAME=rag_documents

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
TOP_K=4

# Generation
TEMPERATURE=0.1
NUM_CTX=4096
